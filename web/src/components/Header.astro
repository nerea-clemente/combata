---
import { url, stripBase } from '../data/url';
import { nav } from '../data/site';
import { faqs } from '../data/faq';
import Icon from './Icon.astro';
interface Props { theme?: 'dark' | 'light' }
const { theme = 'dark' } = Astro.props;
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/') || (href === '/comprar' && path.startsWith('/productos'));
const searchIndex = [
  { t: 'Combata Original', d: 'La tapa reutilizable que se adapta a tu vaso.', h: url('/productos/combata-original') },
  { t: 'Comprar', d: 'Todos los productos', h: url('/comprar') },
  { t: 'Combata Custom', d: 'Personaliza Combata para tu evento, marca o celebración.', h: url('/custom') },
  { t: 'Solicitar presupuesto', d: 'Combata Custom', h: url('/custom#presupuesto') },
  { t: 'Sobre Combata', d: 'Que estar pendiente de tu bebida no sea parte del plan.', h: url('/sobre-combata') },
  { t: 'Contacto', d: '', h: url('/contacto') },
  ...faqs.map((f) => ({ t: f.q, d: 'Preguntas frecuentes', h: url('/preguntas-frecuentes') })),
];
---
<header class:list={['site-header', `site-header--${theme}`]} data-header>
  <div class="site-header__inner">
    <a href={url('/')} class="site-header__logo" aria-label="Combata, ir al inicio">
      {theme === 'dark' && <img class="logo-on-dark" src={url('/brand/logo_combata_blanco.svg')} alt="Combata" width="160" height="33" />}
      <img class:list={['logo-on-light', { 'is-mobile-only': theme === 'dark' }]} src={url('/brand/logo_combata_principal.svg')} alt={theme === 'dark' ? '' : 'Combata'} width="160" height="33" />
    </a>
    <nav class="site-nav" aria-label="Principal">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <button type="button" class="icon-btn icon-btn--desk" data-search-open aria-label="Buscar" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L20 20"/></svg>
      </button>
      <a class="icon-btn icon-btn--desk" href={url('/cuenta')} aria-label="Mi cuenta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.2-3.6 4.1-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
      </a>
      <button type="button" class="icon-btn" data-cart-open aria-label="Abrir carrito" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h2.6l2.2 11h10.2l2-8H6.3"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="16.5" cy="19.5" r="1.4"/></svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
      <button type="button" class="icon-btn menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Menú móvil">
      <ul role="list">
        <li><a href={url('/')}>Inicio</a></li>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href={url('/contacto')}>Contacto</a></li>
      </ul>
      <div class="mobile-menu__cta">
        <a class="btn btn-primary btn-block" href={url('/productos/combata-original')}>Comprar ahora</a>
        <a class="btn btn-secondary btn-block" href={url('/custom#presupuesto')}>Solicitar presupuesto</a>
      </div>
    </nav>
  </div>
</header>

<dialog class="search" data-search aria-label="Buscar en Combata">
  <form method="dialog" class="search__box" role="search">
    <label for="search-q" class="visually-hidden">Buscar</label>
    <input id="search-q" type="search" placeholder="Buscar en Combata" autocomplete="off" data-search-input />
    <button type="submit" class="search__close" aria-label="Cerrar búsqueda"><Icon name="close" /></button>
  </form>
  <ul role="list" class="search__results" data-search-results aria-live="polite"></ul>
  <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex)} />
</dialog>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-cream); color: var(--color-purple); }
  .site-header--dark { background: #1C0729; color: #fff; }
  .site-header__inner {
    position: relative; display: flex; align-items: center;
    width: calc(var(--fw) * var(--u)); margin-inline: auto; height: calc(47 * var(--u)); padding: 0 calc(22 * var(--u));
  }
  .site-header__logo { display: block; flex: none; }
  .site-header__logo img { width: calc(102 * var(--u)); height: auto; display: block; }
  .is-mobile-only { display: none !important; }
  .site-nav { margin-left: calc(37 * var(--u)); }
  .site-nav ul { display: flex; gap: calc(19 * var(--u)); }
  .site-nav a { text-decoration: none; font-weight: 600; font-size: calc(9.6 * var(--u)); letter-spacing: -.005em; padding: calc(6 * var(--u)) 0; position: relative; white-space: nowrap; }
  .site-nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: calc(1 * var(--u)); height: calc(2 * var(--u)); border-radius: calc(2 * var(--u)); background: var(--color-lime); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
  .site-nav a:hover::after { transform: scaleX(1); }
  .site-header__actions { margin-left: auto; display: flex; align-items: center; gap: calc(4 * var(--u)); }
  .icon-btn { position: relative; width: calc(23 * var(--u)); height: calc(23 * var(--u)); display: grid; place-items: center; background: none; border: 0; padding: 0; color: inherit; border-radius: 50%; }
  .icon-btn svg { width: calc(15 * var(--u)); height: calc(15 * var(--u)); }
  .icon-btn:hover { background: rgba(127, 127, 127, .15); }
  .cart-count {
    position: absolute; top: calc(-3 * var(--u)); right: calc(-4 * var(--u)); min-width: calc(15 * var(--u)); height: calc(15 * var(--u)); padding: 0 calc(3 * var(--u)); border-radius: calc(8 * var(--u));
    background: var(--color-lime); color: var(--color-purple); font-size: calc(8.5 * var(--u)); font-weight: 800; line-height: calc(15 * var(--u)); text-align: center;
  }
  .menu-btn { display: none; }
  .mobile-menu { display: none; }

  /* móvil (diseño de teléfono) */
  @media (max-width: 760px) {
    .site-header { background: #fff; color: var(--color-purple); }
    .site-header--dark { background: #fff; color: var(--color-purple); }
    .site-header__inner { width: 100%; height: calc(48 * var(--m)); padding: 0 calc(14 * var(--m)); }
    .site-header__logo img { width: calc(91 * var(--m)); }
    .logo-on-dark { display: none !important; }
    .is-mobile-only { display: block !important; }
    .site-nav, .icon-btn--desk { display: none; }
    .site-header__actions { gap: calc(12 * var(--m)); margin-right: calc(-3 * var(--m)); }
    .icon-btn { width: calc(24 * var(--m)); height: calc(24 * var(--m)); }
    .icon-btn svg { width: calc(17 * var(--m)); height: calc(17 * var(--m)); }
    .cart-count { top: calc(-2 * var(--m)); right: calc(-3 * var(--m)); min-width: calc(13 * var(--m)); height: calc(13 * var(--m)); line-height: calc(13 * var(--m)); font-size: calc(7.5 * var(--m)); border-radius: calc(7 * var(--m)); padding: 0 calc(2 * var(--m)); }
    .menu-btn { display: grid; }
    .mobile-menu:not([hidden]) {
      display: block; position: fixed; inset: calc(48 * var(--m)) 0 0 0; background: var(--color-cream); overflow-y: auto;
      padding: 1.25rem var(--gutter) 2rem; border-top: 1px solid var(--color-line);
    }
    .mobile-menu ul a { display: block; padding: .9rem 0; font-size: 1.6rem; font-weight: 700; letter-spacing: -.03em; text-decoration: none; border-bottom: 1px solid var(--color-line); }
    .mobile-menu__cta { display: grid; gap: .75rem; margin-top: 2rem; }
  }

  .search { margin: 12vh auto auto; width: min(640px, 92vw); border: 0; padding: 0; border-radius: 18px; background: var(--color-cream); color: var(--color-purple); box-shadow: 0 30px 80px rgba(26,11,61,.35); }
  .search::backdrop { background: rgba(26,11,61,.5); }
  .search__box { display: flex; align-items: center; gap: .5rem; padding: .75rem .75rem .75rem 1.25rem; border-bottom: 1px solid var(--color-line); }
  .search__box input { flex: 1; border: 0; background: none; font-size: 1.2rem; padding: .6rem 0; outline: none; box-shadow: none; }
  .search__close { width: 44px; height: 44px; border: 0; background: none; border-radius: 50%; display: grid; place-items: center; }
  .search__close :global(svg) { width: 22px; height: 22px; }
  .search__results { max-height: 50vh; overflow-y: auto; padding: .5rem; }
  .search__results :global(a) { display: block; padding: .75rem .9rem; border-radius: 10px; text-decoration: none; }
  .search__results :global(a:hover), .search__results :global(a:focus-visible) { background: rgba(26,11,61,.06); }
  .search__results :global(strong) { display: block; font-weight: 600; }
  .search__results :global(span) { font-size: .85rem; color: var(--color-muted); }
  .search__results :global(.empty) { padding: 1rem .9rem; color: var(--color-muted); }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
  window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => e.matches && setOpen(false));
  void header;

  // Búsqueda
  const dlg = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-search-input]')!;
  const results = dlg.querySelector<HTMLElement>('[data-search-results]')!;
  const index: { t: string; d: string; h: string }[] = JSON.parse(dlg.querySelector('[data-search-index]')!.textContent || '[]');
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const render = () => {
    const q = norm(input.value.trim());
    const list = q ? index.filter((i) => norm(i.t + ' ' + i.d).includes(q)) : index.slice(0, 5);
    results.innerHTML = list.length
      ? list.slice(0, 8).map((i) => `<li><a href="${i.h}"><strong>${esc(i.t)}</strong>${i.d ? `<span>${esc(i.d)}</span>` : ''}</a></li>`).join('')
      : `<li class="empty">No hay resultados para «${esc(input.value)}».</li>`;
  };
  input.addEventListener('input', render);
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', () => { render(); dlg.showModal(); input.focus(); }));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  results.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) dlg.close(); });
</script>
