---
import { PENDING_ANSWER, type Faq } from '../data/faq';
import { SHOW_PENDING } from '../data/site';
import Pending from './Pending.astro';
interface Props { items: Faq[]; hidePending?: boolean }
const { items, hidePending = false } = Astro.props;
const list = hidePending ? items.filter((f) => f.answer) : items;
---
<div class="faq">
  {list.map((f) => (
    <details>
      <summary>
        <span>{f.q}</span>
        <span class="plus" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </summary>
      <div class="answer">
        {f.answer ? <p>{f.answer}</p> : (
          <p>{PENDING_ANSWER} {SHOW_PENDING && <Pending label="Respuesta pendiente" />}</p>
        )}
      </div>
    </details>
  ))}
</div>
