---
import { url } from '../../data/url';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import Pending from '../../components/Pending.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { faqs } from '../../data/faq';

const audiences = [
  { t: 'Bodas y celebraciones', d: 'Un detalle útil para tus invitados, con vuestro nombre, fecha o diseño.' },
  { t: 'Festivales', d: 'Merchandising práctico que se usa durante el evento y después.' },
  { t: 'Universidades', d: 'Para fiestas, bienvenidas, asociaciones y actividades del campus.' },
  { t: 'Locales de ocio', d: 'Bares, discotecas y salas que quieren ofrecer algo más a su público.' },
  { t: 'Marcas y agencias', d: 'Acciones de marca y merchandising con un objeto que se usa de verdad.' },
];
const steps = [
  { t: 'Cuéntanos tu idea', d: 'Rellena el formulario con tu evento, la cantidad aproximada y lo que quieres personalizar.' },
  { t: 'Preparamos una propuesta', d: 'Revisamos la viabilidad y te enviamos una propuesta con presupuesto.' },
  { t: 'Confirmamos diseño y pedido', d: 'Ajustamos el diseño contigo y lo confirmamos antes de producir.' },
  { t: 'Producción y entrega', d: 'Fabricamos tu pedido y coordinamos la entrega.' },
];
const customFaqs = faqs.filter((f) => f.group === 'custom');
---
<Base
  title="Combata Custom | Protectores de bebidas personalizados"
  description="Personaliza Combata con tu diseño, logo o mensaje para bodas, festivales, universidades, locales y acciones de marca. Solicita presupuesto."
>
  <section class="dark on-dark c-hero">
    <div class="container c-hero__grid">
      <div class="c-hero__copy">
        <h1 class="h-hero c-hero__title">Combata Custom.</h1>
        <p class="lead">Tu diseño, tu evento, tu Combata.</p>
        <p class="muted c-hero__text">Personaliza nuestros protectores de bebidas para eventos, celebraciones y acciones de marca.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#presupuesto">Solicitar presupuesto <Icon name="arrow" /></a>
          <a class="btn btn-secondary" href="#proceso">Cómo funciona</a>
        </div>
      </div>
      <div class="c-hero__media">
        <Placeholder label="Ejemplo de personalización: Combata con logo" note="Mockup o ejemplo real pendiente" tone="lavender" ratio="1 / 1" sticker={url('/brand/rayos.svg')} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="what-custom">
    <div class="container split2">
      <div>
        <p class="index">01</p>
        <h2 id="what-custom" class="h-1">Qué puedes personalizar</h2>
      </div>
      <div class="opts">
        <div><h3 class="h-2">Tu logo</h3><p class="muted">Para marcas, locales, festivales e instituciones.</p></div>
        <div><h3 class="h-2">Tu diseño</h3><p class="muted">Una ilustración, un patrón o la identidad de tu evento.</p></div>
        <div><h3 class="h-2">Tu mensaje</h3><p class="muted">Un nombre, una fecha o una frase.</p></div>
        <p class="small muted opts__note">Las técnicas de impresión, colores y tamaños de marcaje dependen de las posibilidades reales de producción. Te lo concretamos en la propuesta. <Pending label="Especificaciones pendientes" /></p>
      </div>
    </div>
  </section>

  <section class="section paper" aria-labelledby="who">
    <div class="container">
      <p class="index">02</p>
      <h2 id="who" class="h-1 who__title">Para quién</h2>
      <ul role="list" class="aud">
        {audiences.map((a) => (
          <li class="reveal"><h3 class="h-3">{a.t}</h3><p class="muted">{a.d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="examples">
    <div class="container">
      <div class="ex__head">
        <div><p class="index">03</p><h2 id="examples" class="h-1">Ejemplos</h2></div>
        <p class="muted ex__text">Aquí mostraremos ejemplos reales de pedidos personalizados. Las simulaciones se identificarán como «Ejemplo de personalización».</p>
      </div>
      <div class="ex__grid">
        <Placeholder label="Ejemplo de personalización · Boda" note="Pendiente" tone="sand" ratio="4 / 5" />
        <Placeholder label="Ejemplo de personalización · Festival" note="Pendiente" tone="purple" ratio="4 / 5" />
        <Placeholder label="Ejemplo de personalización · Marca" note="Pendiente" tone="lavender" ratio="4 / 5" />
      </div>
    </div>
  </section>

  <section class="section dark on-dark" id="proceso" aria-labelledby="process">
    <div class="container">
      <div class="proc__head">
        <h2 id="process" class="h-1">Cómo funciona</h2>
        <Pending label="Ajustar al proceso operativo real" />
      </div>
      <ol role="list" class="proc">
        {steps.map((s, i) => (
          <li class="reveal"><span class="proc__n">{String(i + 1).padStart(2, '0')}</span><h3 class="h-3">{s.t}</h3><p class="muted">{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="b2b-faq">
    <div class="container split2">
      <div><h2 id="b2b-faq" class="h-1">Preguntas frecuentes</h2></div>
      <FaqList items={customFaqs} />
    </div>
  </section>

  <section class="section paper" id="presupuesto" aria-labelledby="quote-title">
    <div class="container split2">
      <div class="q-intro">
        <p class="eyebrow">Presupuesto</p>
        <h2 id="quote-title" class="h-1">Cuéntanos tu idea.</h2>
        <p class="muted">Cuantos más detalles nos des, más ajustada será la propuesta. Te respondemos por email.</p>
      </div>
      <QuoteForm />
    </div>
  </section>
</Base>

<style>
  .c-hero { padding-block: clamp(3rem, 6vw, 6rem); }
  .c-hero__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .c-hero__copy { display: grid; gap: 1.5rem; justify-items: start; }
  .c-hero__title { font-size: clamp(3rem, 1.5rem + 6vw, 6.25rem); }
  .c-hero .lead { font-weight: 600; }
  .c-hero__text { max-width: 44ch; margin-top: -.5rem; }
  .split2 { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 6rem); }
  .split2 > div:first-child { display: grid; gap: 1rem; align-content: start; }
  .opts { display: grid; gap: 0; }
  .opts > div { padding: 1.5rem 0; border-bottom: 1px solid var(--color-line); display: grid; grid-template-columns: 1fr 1.3fr; gap: 1rem; align-items: baseline; }
  .opts > div:first-child { border-top: 1px solid var(--color-line); }
  .opts__note { margin-top: 1.25rem; }
  .who__title { margin: 1rem 0 clamp(2rem, 4vw, 3.5rem); }
  .aud { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.5rem; }
  .aud li { border-top: 1.5px solid var(--color-purple); padding-top: 1.25rem; display: grid; gap: .6rem; align-content: start; }
  .ex__head { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 6rem); align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .ex__head > div { display: grid; gap: 1rem; }
  .ex__text { max-width: 52ch; }
  .ex__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .proc__head { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .proc { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .proc li { border-top: 1px solid rgba(245,244,238,.25); padding-top: 1.25rem; display: grid; gap: .6rem; align-content: start; }
  .proc__n { font-size: var(--step-3); font-weight: 700; color: var(--color-lime); letter-spacing: -.03em; }
  .q-intro { position: sticky; top: calc(var(--header-h) + 2rem); }
  @media (max-width: 1000px) { .aud { grid-template-columns: repeat(2, 1fr); } .proc { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 860px) {
    .c-hero__grid, .split2, .ex__head { grid-template-columns: 1fr; }
    .c-hero__media { max-width: 460px; }
    .q-intro { position: static; }
    .ex__grid { grid-template-columns: 1fr 1fr; }
    .ex__grid > :last-child { display: none; }
  }
  @media (max-width: 560px) {
    .aud, .proc { grid-template-columns: 1fr; }
    .opts > div { grid-template-columns: 1fr; gap: .25rem; }
  }
</style>
