---
import { url } from '../../data/url';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const uses = [
  { icon: 'rings', label: 'Bodas' },
  { icon: 'music', label: 'Festivales' },
  { icon: 'cap', label: 'Universidades' },
  { icon: 'globe', label: 'Discotecas' },
  { icon: 'sparkles', label: 'Marcas y eventos' },
] as const;
---
<Base
  title="Combata Custom | Protectores de bebidas personalizados"
  description="Personaliza Combata con tu logo, diseño o mensaje para bodas, festivales, universidades, discotecas, marcas y eventos. Solicita presupuesto."
  header="light"
>
  <section class="c-hero">
    <div class="container c-hero__grid">
      <div class="c-hero__copy">
        <h1 class="c-hero__title">Combata<br />Custom <img class="c-hero__rays" src={url('/brand/rayos.svg')} alt="" width="80" height="62" /></h1>
        <p class="c-hero__lead">Personaliza Combata para tu<br />evento, marca o celebración.</p>
        <ul role="list" class="checks">
          <li><Icon name="check" /> Con tu logo, diseño o mensaje</li>
          <li><Icon name="check" /> Ideal para bodas, festivales, universidades y discotecas</li>
          <li><Icon name="check" /> Pedidos a medida y asesoramiento personalizado</li>
        </ul>
        <a class="btn btn-primary" href="#presupuesto">Solicitar presupuesto <Icon name="arrow" /></a>
      </div>
      <div class="c-hero__media">
        <img src={url('/img/custom_hero.jpg')} alt="Vaso con tapa Combata lavanda personalizada con el texto «Tu logo»" width="1056" height="870" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="uses-sec" aria-label="Para quién">
    <div class="container">
      <ul role="list" class="uses">
        {uses.map((u) => (
          <li><Icon name={u.icon} /><span>{u.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="presupuesto" aria-labelledby="quote-title">
    <div class="container q">
      <div class="q__intro">
        <h2 id="quote-title" class="q__title">Solicita tu presupuesto</h2>
        <p class="muted">Cuéntanos tu idea, el tipo de evento y la cantidad aproximada. Te respondemos por email con una propuesta.</p>
      </div>
      <QuoteForm />
    </div>
  </section>
</Base>

<style>
  .c-hero { background: #F7F0EA; overflow: hidden; }
  .c-hero__grid { display: grid; grid-template-columns: 1fr 1.05fr; align-items: center; gap: clamp(1.5rem, 4vw, 3rem); }
  .c-hero__copy { display: grid; gap: 1.25rem; justify-items: start; padding-block: clamp(2.5rem, 6vw, 5rem); }
  .c-hero__title { font-size: clamp(3rem, 1.8rem + 4.4vw, 5.5rem); line-height: .98; letter-spacing: -.04em; position: relative; }
  .c-hero__rays { display: inline-block; width: .8em; height: auto; vertical-align: top; margin-left: .1em; transform: translateY(-.15em) rotate(4deg); }
  .c-hero__lead { font-size: var(--step-2); line-height: 1.3; font-weight: 500; letter-spacing: -.015em; }
  .checks { display: grid; gap: .65rem; }
  .checks li { display: flex; gap: .7rem; align-items: flex-start; font-weight: 500; max-width: 34ch; line-height: 1.4; }
  .checks :global(svg) { width: 1.35rem; height: 1.35rem; flex: none; color: #A7C400; stroke-width: 2.6; margin-top: .05rem; }
  .c-hero .btn { margin-top: .75rem; }
  .c-hero__media { align-self: stretch; display: flex; align-items: center; justify-content: flex-end; }
  .c-hero__media img {
    width: 100%; max-width: 720px;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14%, #000 90%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 10%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0, #000 14%, #000 90%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 10%, #000 88%, transparent 100%);
    mask-composite: intersect;
  }

  .uses-sec { padding-block: clamp(1.5rem, 3vw, 2.25rem); background: var(--color-cream); }
  .uses { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
  .uses li {
    display: grid; justify-items: center; gap: .9rem; padding: 1.75rem 1rem 1.5rem; text-align: center;
    background: var(--color-paper); border-radius: var(--radius-l); box-shadow: 0 1px 0 rgba(26,11,61,.06), 0 6px 18px rgba(26,11,61,.05);
    font-weight: 700; font-size: var(--step--1);
  }
  .uses :global(svg) { width: 44px; height: 44px; stroke-width: 1.5; }

  .q { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 6rem); }
  .q__intro { display: grid; gap: 1rem; align-content: start; position: sticky; top: calc(var(--header-h) + 2rem); }
  .q__title { font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem); letter-spacing: -.035em; line-height: 1; }

  @media (max-width: 900px) {
    .c-hero__grid, .q { grid-template-columns: 1fr; }
    .c-hero__copy { padding-bottom: 0; }
    .q__intro { position: static; }
    .uses { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 520px) { .uses { grid-template-columns: 1fr 1fr; } }
</style>
