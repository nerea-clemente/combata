---
import { url } from '../../data/url';
import Base from '../../layouts/Base.astro';
import { product, formatPrice } from '../../data/site';

const gallery = [
  { src: '/img/producto_principal.jpg', thumb: '/img/thumb_1.jpg', small: false, alt: 'Tapas Combata apiladas en lima, rosa y lavanda' },
  { src: '/img/thumb_2.jpg', thumb: '/img/thumb_2.jpg', small: true, alt: 'Tapa Combata rosa vista desde arriba' },
  { src: '/img/thumb_3.jpg', thumb: '/img/thumb_3.jpg', small: true, alt: 'Tapa Combata lavanda flexible entre dos manos' },
  { src: '/img/thumb_4.jpg', thumb: '/img/thumb_4.jpg', small: true, alt: 'Vaso con tapa Combata rosa y pajita' },
];
const firstColour = product.colours.find((c) => c.available);
const firstPack = product.packs[0];
const ic = {
  refresh: '<path d="M20 11a8 8 0 0 0-14.3-4.6L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.6L20 16M20 20v-4h-4"/>',
  drop: '<path d="M12 3.2c3.4 4.3 6 7.8 6 11a6 6 0 0 1-12 0c0-3.2 2.6-6.7 6-11z"/>',
  cup: '<path d="M4.5 5.5h15M6 5.5l1.6 14.5h8.8L18 5.5"/>',
  truck: '<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
};
const features = [
  { k: 'refresh', t: 'Reutilizable', x: 42 },
  { k: 'drop', t: 'Fácil de limpiar', x: 167 },
  { k: 'cup', t: product.details.compatibilidad, x: 300 },
  { k: 'truck', t: product.details.envio, x: 477 },
].filter((f) => f.t) as { k: keyof typeof ic; t: string; x: number }[];
const cart = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h2.6l2.2 11h10.2l2-8H6.3"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="16.5" cy="19.5" r="1.4"/></svg>';
---
<Base
  title="Combata Original | Protector reutilizable para vasos"
  description="Combata Original, la tapa reutilizable de silicona que se adapta a tu vaso. Elige tu color y tu pack."
  frame={625}
>
  <div class="pdp">
    <div class="frame pdp__frame">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <ol>
          <li><a href={url('/')}>Inicio</a></li>
          <li><a href={url('/comprar')}>Productos</a></li>
          <li aria-current="page">Combata Original</li>
        </ol>
      </nav>

      <div class="thumbs" role="group" aria-label="Elegir imagen">
        {gallery.map((g, i) => (
          <button type="button" class="thumb" style={`top:calc(${44 + i * 79.6} * var(--u))`} data-thumb={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Ver imagen ${i + 1}: ${g.alt}`}>
            <img src={url(g.thumb)} alt="" width="198" height="210" />
          </button>
        ))}
      </div>
      <div class="main">
        {gallery.map((g, i) => (
          <img class:list={['main__img', { 'is-small': g.small }]} data-slide={i} hidden={i !== 0} src={url(g.src)} alt={g.alt} loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
      </div>

      <h1 class="title">Combata Original</h1>
      <p class="short">{product.short}</p>
      {product.reviews && <p class="reviews"><span aria-hidden="true">★★★★★</span> {product.reviews.rating.toLocaleString('es-ES')} ({product.reviews.count} reseñas)</p>}
      <p class="price" data-price>{formatPrice(firstPack ? firstPack.price : product.price)}</p>

      <form class="buy" data-buy novalidate>
        <fieldset class="colours">
          <legend>Color: <span data-colour-name>{firstColour?.name}</span></legend>
          {product.colours.map((c, i) => (
            <label class="colour" style={`left:calc(${i * 45.5} * var(--u))`} title={c.name}>
              <input type="radio" name="colour" value={c.id} data-name={c.name} checked={c === firstColour} disabled={!c.available} />
              <span class="colour__dot" style={`--c:${c.hex}`}></span>
              <span class="visually-hidden">{c.name}</span>
            </label>
          ))}
        </fieldset>
        {product.packs.length > 0 && (
          <fieldset class="packs">
            <legend>Formato:</legend>
            {product.packs.map((p, i) => (
              <label class="pack" style={`left:calc(${[0, 87, 172][i] ?? i * 86} * var(--u)); width:calc(${i === 0 ? 77 : 73} * var(--u))`}>
                <input type="radio" name="pack" value={p.id} data-price={formatPrice(p.price)} checked={i === 0} />
                <span class="pack__box"><strong>{p.label}</strong><small>{formatPrice(p.price)}</small>{p.discount && <small>({p.discount})</small>}</span>
              </label>
            ))}
          </fieldset>
        )}
        <p class="err" data-buy-error role="alert"></p>
        <button type="submit" class="add"><Fragment set:html={cart} /> Añadir al carrito</button>
      </form>

      <ul role="list" class="features">
        {features.map((f) => (
          <li style={`left:calc(${f.x} * var(--u))`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic[f.k]} />
            <span>{f.t}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

<style>
  .pdp { background: #F7F2ED; }
  .frame { position: relative; width: calc(625 * var(--u)); margin-inline: auto; }
  .pdp__frame { height: calc(505 * var(--u)); color: #1A0B3D; }
  .crumbs { position: absolute; left: calc(22 * var(--u)); top: calc(16 * var(--u)); }
  .crumbs ol { display: flex; gap: calc(6 * var(--u)); list-style: none; padding: 0; margin: 0; font-size: calc(9.5 * var(--u)); font-weight: 500; }
  .crumbs li + li::before { content: '›'; margin-right: calc(6 * var(--u)); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .thumb { position: absolute; left: calc(12 * var(--u)); width: calc(67 * var(--u)); height: calc(70 * var(--u)); padding: 0; border: calc(1.5 * var(--u)) solid transparent; border-radius: calc(9 * var(--u)); overflow: hidden; background: #F3ECE6; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb[aria-pressed='true'] { border-color: #1A0B3D; }
  .thumb:hover { border-color: rgba(26,11,61,.4); }
  .main { position: absolute; left: calc(90 * var(--u)); top: calc(43 * var(--u)); width: calc(260 * var(--u)); height: calc(340 * var(--u)); border-radius: calc(14 * var(--u)); overflow: hidden; background: #F2EAE3; display: grid; place-items: center; }
  .main__img { width: 100%; height: 100%; object-fit: cover; }
  .main__img.is-small { width: 60%; height: auto; object-fit: contain; border-radius: calc(10 * var(--u)); }

  .title { position: absolute; left: calc(369 * var(--u)); top: calc(42 * var(--u)); margin: 0; font-size: calc(26.6 * var(--u)); line-height: calc(32 * var(--u)); font-weight: 760; letter-spacing: -.03em; white-space: nowrap; }
  .short { position: absolute; left: calc(369 * var(--u)); top: calc(80 * var(--u)); margin: 0; font-size: calc(11 * var(--u)); line-height: calc(14 * var(--u)); }
  .reviews { position: absolute; left: calc(369 * var(--u)); top: calc(111 * var(--u)); margin: 0; font-size: calc(9.5 * var(--u)); font-weight: 600; }
  .price { position: absolute; left: calc(369 * var(--u)); top: calc(133 * var(--u)); margin: 0; font-size: calc(25 * var(--u)); line-height: calc(30 * var(--u)); font-weight: 800; letter-spacing: -.02em; }
  .buy { position: absolute; left: calc(369 * var(--u)); top: 0; width: calc(250 * var(--u)); height: 100%; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-size: calc(12 * var(--u)); font-weight: 600; padding: 0; }
  .colours { position: absolute; left: 0; top: calc(179 * var(--u)); width: calc(250 * var(--u)); height: calc(70 * var(--u)); }
  .colours legend { position: absolute; top: 0; }
  .colour { position: absolute; top: calc(26 * var(--u)); cursor: pointer; }
  .colour input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: inherit; }
  .colour__dot { display: block; width: calc(36 * var(--u)); height: calc(36 * var(--u)); border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgba(26,11,61,.06); }
  .colour input:checked + .colour__dot { box-shadow: 0 0 0 calc(2 * var(--u)) #F7F2ED, 0 0 0 calc(3.6 * var(--u)) #1A0B3D; }
  .colour input:focus-visible + .colour__dot { outline: 2px solid #1A0B3D; outline-offset: calc(5 * var(--u)); }
  .packs { position: absolute; left: 0; top: calc(252 * var(--u)); width: calc(250 * var(--u)); height: calc(90 * var(--u)); }
  .packs legend { position: absolute; top: 0; }
  .pack { position: absolute; top: calc(21 * var(--u)); height: calc(57 * var(--u)); cursor: pointer; }
  .pack input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: inherit; }
  .pack__box { display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; border: calc(1 * var(--u)) solid rgba(26,11,61,.35); border-radius: calc(9 * var(--u)); background: #FBF8F4; text-align: center; line-height: 1.25; }
  .pack__box strong { font-size: calc(11.5 * var(--u)); font-weight: 700; }
  .pack__box small { font-size: calc(8.6 * var(--u)); }
  .pack input:checked + .pack__box { background: #1A0B3D; color: #fff; border-color: #1A0B3D; }
  .pack input:focus-visible + .pack__box { outline: 2px solid #1A0B3D; outline-offset: calc(3 * var(--u)); }
  .err { position: absolute; top: calc(388 * var(--u)); font-size: calc(10 * var(--u)); color: var(--color-error); margin: 0; }
  .add {
    position: absolute; left: 0; top: calc(348 * var(--u)); width: calc(245 * var(--u)); height: calc(36 * var(--u)); border: 0; border-radius: 999px;
    background: #DFFF1A; color: #1A0B3D; font-size: calc(12.5 * var(--u)); font-weight: 700; display: flex; align-items: center; justify-content: center; gap: calc(7 * var(--u));
  }
  .add:hover { background: #EAFF5C; }
  .add :global(svg) { width: calc(16 * var(--u)); height: calc(16 * var(--u)); }
  .features { position: absolute; left: 0; top: calc(405 * var(--u)); width: 100%; height: calc(40 * var(--u)); list-style: none; padding: 0; margin: 0; }
  .features li { position: absolute; top: 0; height: calc(40 * var(--u)); display: flex; align-items: center; gap: calc(9 * var(--u)); font-size: calc(9.8 * var(--u)); font-weight: 500; line-height: 1.3; max-width: calc(140 * var(--u)); }
  .features li:nth-child(3) span { max-width: calc(112 * var(--u)); }
  .features svg { width: calc(20 * var(--u)); height: calc(20 * var(--u)); flex: none; }
  .pdp__frame { height: calc(458 * var(--u)); }

  @media (max-width: 760px) {
    .frame { width: 100%; }
    .pdp__frame { height: auto; display: grid; gap: 14px; padding: 16px var(--gutter) 40px; }
    .crumbs, .thumbs, .thumb, .main, .title, .short, .reviews, .price, .buy, .colours, .colour, .packs, .pack, .err, .add, .features, .features li { position: static; }
    .crumbs ol { font-size: 13px; gap: 6px; flex-wrap: wrap; }
    .main { width: 100%; height: auto; aspect-ratio: 258 / 338; border-radius: 18px; order: 1; }
    .thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; order: 2; }
    .thumb { width: auto; height: auto; aspect-ratio: 67 / 70; border-radius: 12px; border-width: 2px; }
    .title { order: 3; font-size: 34px; line-height: 1.05; white-space: normal; margin-top: 8px; }
    .short { order: 4; font-size: 15px; line-height: 1.4; }
    .reviews { order: 5; font-size: 13px; }
    .price { order: 6; font-size: 32px; line-height: 1.1; }
    .buy { order: 7; width: auto; height: auto; display: grid; gap: 18px; }
    .colours, .packs { width: auto; height: auto; }
    .colours { display: flex; flex-wrap: wrap; gap: 12px; }
    legend { font-size: 15px; margin-bottom: 10px; position: static !important; width: 100%; }
    .colour__dot { width: 44px; height: 44px; }
    .colour input:checked + .colour__dot { box-shadow: 0 0 0 3px #F7F2ED, 0 0 0 5px #1A0B3D; }
    .packs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .pack { width: auto !important; height: 66px; }
    .pack__box { border-radius: 12px; border-width: 1.5px; }
    .pack__box strong { font-size: 14px; } .pack__box small { font-size: 11.5px; }
    .add { width: 100%; height: 54px; font-size: 16px; gap: 8px; }
    .add :global(svg) { width: 20px; height: 20px; }
    .err { font-size: 14px; }
    .features { order: 8; height: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 10px; }
    .features li { height: auto; font-size: 13px; gap: 10px; max-width: none; }
    .features li:nth-child(3) span { max-width: none; }
    .features svg { width: 26px; height: 26px; }
  }
</style>

<script>
  import { addLine, toast } from '../../scripts/cart';
  import { product } from '../../data/site';
  const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-thumb]');
  const slides = document.querySelectorAll<HTMLElement>('[data-slide]');
  thumbs.forEach((t) => t.addEventListener('click', () => {
    thumbs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    slides.forEach((s) => (s.hidden = s.dataset.slide !== t.dataset.thumb));
  }));
  const form = document.querySelector<HTMLFormElement>('[data-buy]')!;
  const err = form.querySelector<HTMLElement>('[data-buy-error]')!;
  const colourName = form.querySelector<HTMLElement>('[data-colour-name]');
  const priceEl = document.querySelector<HTMLElement>('[data-price]');
  form.querySelectorAll<HTMLInputElement>('input[name="colour"]').forEach((r) =>
    r.addEventListener('change', () => { if (colourName) colourName.textContent = r.dataset.name || ''; }));
  form.querySelectorAll<HTMLInputElement>('input[name="pack"]').forEach((r) =>
    r.addEventListener('change', () => { if (priceEl && r.dataset.price) priceEl.textContent = r.dataset.price; }));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    err.textContent = '';
    const colour = form.querySelector<HTMLInputElement>('input[name="colour"]:checked');
    const pack = form.querySelector<HTMLInputElement>('input[name="pack"]:checked');
    try {
      addLine({ productId: product.id, colourId: colour?.value ?? null, packId: pack?.value ?? null, qty: 1 });
      toast(`Añadido al carrito: Combata Original${colour ? ' · ' + colour.dataset.name : ''}`);
      document.dispatchEvent(new CustomEvent('cart:open'));
    } catch (ex) {
      err.textContent = 'No hemos podido añadirlo al carrito. ' + (ex instanceof Error ? ex.message : '');
      toast('No se ha podido añadir al carrito', 'error');
    }
  });
</script>
