---
import { url } from '../../data/url';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { product, formatPrice } from '../../data/site';

const gallery = [
  { src: '/img/producto_principal.jpg', thumb: '/img/thumb_1.jpg', w: 774, h: 1014, alt: 'Tapas Combata apiladas en lima, rosa y lavanda' },
  { src: '/img/thumb_2.jpg', thumb: '/img/thumb_2.jpg', w: 198, h: 210, alt: 'Tapa Combata rosa vista desde arriba' },
  { src: '/img/thumb_3.jpg', thumb: '/img/thumb_3.jpg', w: 198, h: 210, alt: 'Tapa Combata lavanda flexible entre dos manos' },
  { src: '/img/thumb_4.jpg', thumb: '/img/thumb_4.jpg', w: 198, h: 210, alt: 'Vaso con tapa Combata rosa y pajita' },
];
const firstColour = product.colours.find((c) => c.available);
const firstPack = product.packs[0];
const features = [
  { icon: 'refresh', text: 'Reutilizable' },
  { icon: 'drop', text: 'Fácil de limpiar' },
  { icon: 'cup', text: product.details.compatibilidad },
  { icon: 'truck', text: product.details.envio },
].filter((f) => f.text) as { icon: 'refresh' | 'drop' | 'cup' | 'truck'; text: string }[];
---
<Base
  title="Combata Original | Protector reutilizable para vasos"
  description="Combata Original, la tapa reutilizable de silicona que se adapta a tu vaso. Elige tu color y tu pack."
>
  <div class="container pdp">
    <nav class="breadcrumb crumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href={url('/')}>Inicio</a></li>
        <li><a href={url('/comprar')}>Productos</a></li>
        <li aria-current="page">Combata Original</li>
      </ol>
    </nav>

    <div class="pdp__grid">
      <section class="gallery" aria-label="Galería de imágenes">
        <div class="gallery__thumbs" role="group" aria-label="Elegir imagen">
          {gallery.map((g, i) => (
            <button type="button" class="gallery__thumb" data-thumb={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Ver imagen ${i + 1}: ${g.alt}`}>
              <img src={url(g.thumb)} alt="" width="198" height="210" loading={i === 0 ? 'eager' : 'lazy'} />
            </button>
          ))}
        </div>
        <div class="gallery__main">
          {gallery.map((g, i) => (
            <img class:list={['gallery__img', { 'is-small': g.w < 400 }]} data-slide={i} hidden={i !== 0} src={url(g.src)} alt={g.alt} width={g.w} height={g.h} loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
        </div>
      </section>

      <section class="buy" aria-labelledby="pdp-title">
        <h1 id="pdp-title" class="buy__title">Combata Original</h1>
        <p class="buy__short">{product.short}</p>
        {product.reviews && (
          <p class="buy__reviews"><span class="stars" aria-hidden="true">★★★★★</span> {product.reviews.rating.toLocaleString('es-ES')} ({product.reviews.count} reseñas)</p>
        )}
        <p class="buy__price" data-price>{formatPrice(firstPack ? firstPack.price : product.price)}</p>

        <form class="buy__form" data-buy novalidate>
          <fieldset>
            <legend>Color: <span data-colour-name>{firstColour?.name}</span></legend>
            <div class="colours">
              {product.colours.map((c) => (
                <label class="colour" title={c.name}>
                  <input type="radio" name="colour" value={c.id} data-name={c.name} checked={c === firstColour} disabled={!c.available} />
                  <span class="colour__dot" style={`--c:${c.hex}`}></span>
                  <span class="visually-hidden">{c.name}{!c.available && ' (no disponible)'}</span>
                </label>
              ))}
            </div>
          </fieldset>

          {product.packs.length > 0 && (
            <fieldset>
              <legend>Formato:</legend>
              <div class="packs">
                {product.packs.map((p, i) => (
                  <label class="pack">
                    <input type="radio" name="pack" value={p.id} data-price={formatPrice(p.price)} checked={i === 0} />
                    <span class="pack__box">
                      <strong>{p.label}</strong>
                      <small>{formatPrice(p.price)}</small>
                      {p.discount && <small>({p.discount})</small>}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <p class="field-error" data-buy-error role="alert"></p>
          <button type="submit" class="btn btn-primary btn-block buy__cta"><Icon name="cart" /> Añadir al carrito</button>
        </form>
      </section>
    </div>

    <ul role="list" class="features">
      {features.map((f) => (
        <li><Icon name={f.icon} /><span>{f.text}</span></li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .pdp { padding-block: 1.25rem clamp(3rem, 6vw, 5rem); }
  .crumbs li + li::before { content: '›'; font-size: 1.1em; }
  .crumbs a, .crumbs li { color: var(--color-purple); font-weight: 500; }
  .pdp__grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: 1.25rem; align-items: start; }

  .gallery { display: grid; grid-template-columns: 96px 1fr; gap: 1rem; }
  .gallery__thumbs { display: grid; gap: .75rem; align-content: start; }
  .gallery__thumb { padding: 0; border: 2px solid transparent; border-radius: var(--radius); overflow: hidden; background: #FBF6F0; aspect-ratio: 66 / 70; }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumb[aria-pressed='true'] { border-color: var(--color-purple); }
  .gallery__thumb:hover { border-color: rgba(26, 11, 61, .4); }
  .gallery__main { background: #FBF6F0; border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 258 / 338; display: grid; place-items: center; }
  .gallery__img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__img.is-small { width: auto; height: auto; max-width: 60%; object-fit: contain; border-radius: var(--radius); }

  .buy { display: grid; gap: .9rem; align-content: start; padding-top: .5rem; }
  .buy__title { font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem); letter-spacing: -.035em; line-height: 1; }
  .buy__short { font-size: var(--step-0); }
  .buy__reviews { font-size: var(--step--1); font-weight: 600; display: flex; gap: .5rem; align-items: center; }
  .stars { color: var(--color-lime); -webkit-text-stroke: .6px #9BB800; letter-spacing: .05em; font-size: 1.1rem; }
  .buy__price { font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem); font-weight: 800; letter-spacing: -.03em; margin-top: .25rem; }
  .buy__form { display: grid; gap: 1.5rem; margin-top: .25rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-weight: 600; margin-bottom: .75rem; }
  .colours { display: flex; gap: .9rem; flex-wrap: wrap; }
  .colour { position: relative; cursor: pointer; }
  .colour input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: inherit; }
  .colour__dot { display: block; width: 52px; height: 52px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgba(26,11,61,.08); transition: box-shadow .15s; }
  .colour input:checked + .colour__dot { box-shadow: 0 0 0 3px var(--color-cream), 0 0 0 5px var(--color-purple); }
  .colour input:focus-visible + .colour__dot { outline: 3px solid var(--color-purple); outline-offset: 6px; }
  .colour input:disabled + .colour__dot { opacity: .35; cursor: not-allowed; }
  .packs { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .pack { position: relative; cursor: pointer; }
  .pack input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: inherit; }
  .pack__box { display: grid; justify-items: center; gap: .1rem; padding: .85rem .5rem; border: 1.5px solid rgba(26,11,61,.25); border-radius: var(--radius); text-align: center; line-height: 1.25; background: var(--color-paper); transition: background-color .15s, border-color .15s; }
  .pack__box strong { font-size: var(--step-0); }
  .pack__box small { font-size: .78rem; }
  .pack input:checked + .pack__box { background: var(--color-purple); color: var(--color-cream); border-color: var(--color-purple); }
  .pack input:focus-visible + .pack__box { outline: 3px solid var(--color-purple); outline-offset: 3px; }
  .pack:hover .pack__box { border-color: var(--color-purple); }
  .buy__cta { --h: 3.6rem; font-size: var(--step-1); }
  .buy__cta :global(svg) { width: 1.3em; height: 1.3em; }

  .features { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-top: clamp(2rem, 4vw, 3rem); padding: 1.5rem clamp(1rem, 3vw, 2.5rem); border-radius: var(--radius-l); background: var(--color-paper); }
  .features li { display: flex; align-items: center; gap: .75rem; font-size: var(--step--1); font-weight: 600; line-height: 1.3; justify-content: center; }
  .features :global(svg) { width: 30px; height: 30px; flex: none; stroke-width: 1.6; }

  @media (max-width: 900px) {
    .pdp__grid { grid-template-columns: 1fr; }
    .features { grid-template-columns: 1fr 1fr; }
    .features li { justify-content: flex-start; }
  }
  @media (max-width: 520px) {
    .gallery { grid-template-columns: 1fr; }
    .gallery__thumbs { grid-template-columns: repeat(4, 1fr); order: 2; }
  }
</style>

<script>
  import { addLine, toast } from '../../scripts/cart';
  import { product } from '../../data/site';

  const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-thumb]');
  const slides = document.querySelectorAll<HTMLElement>('[data-slide]');
  thumbs.forEach((t) => t.addEventListener('click', () => {
    thumbs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    slides.forEach((s) => (s.hidden = s.dataset.slide !== t.dataset.thumb));
  }));

  const form = document.querySelector<HTMLFormElement>('[data-buy]')!;
  const err = form.querySelector<HTMLElement>('[data-buy-error]')!;
  const colourName = form.querySelector<HTMLElement>('[data-colour-name]');
  const priceEl = document.querySelector<HTMLElement>('[data-price]');
  form.querySelectorAll<HTMLInputElement>('input[name="colour"]').forEach((r) =>
    r.addEventListener('change', () => { if (colourName) colourName.textContent = r.dataset.name || ''; }));
  form.querySelectorAll<HTMLInputElement>('input[name="pack"]').forEach((r) =>
    r.addEventListener('change', () => { if (priceEl && r.dataset.price) priceEl.textContent = r.dataset.price; }));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    err.textContent = '';
    const colour = form.querySelector<HTMLInputElement>('input[name="colour"]:checked');
    const pack = form.querySelector<HTMLInputElement>('input[name="pack"]:checked');
    if (product.colours.length && !colour) { err.textContent = 'Elige un color para continuar.'; return; }
    try {
      addLine({ productId: product.id, colourId: colour?.value ?? null, packId: pack?.value ?? null, qty: 1 });
      toast(`Añadido al carrito: Combata Original${colour ? ' · ' + colour.dataset.name : ''}`);
      document.dispatchEvent(new CustomEvent('cart:open'));
    } catch (ex) {
      err.textContent = 'No hemos podido añadirlo al carrito. ' + (ex instanceof Error ? ex.message : '');
      toast('No se ha podido añadir al carrito', 'error');
    }
  });
</script>
