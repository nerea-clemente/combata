---
import { url } from '../data/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Underline from '../components/Underline.astro';
import { product } from '../data/site';
---
<Base
  title="Combata | Protectores reutilizables para bebidas"
  description="Descubre Combata, el protector reutilizable para tu bebida. Elige tu color o personalízalo para tu evento, festival o celebración."
>
  <!-- HERO -->
  <section class="hero on-dark">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title">Ponle un <span class="u">Combata.<Underline /></span></h1>
        <p class="hero__text">El protector reutilizable para tu bebida. Menos derrames, más tranquilidad y toda la fiesta por delante.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={url(product.href)}>Comprar ahora <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={url('/custom')}>Personalizar <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="hero__media">
        <img src={url('/img/hero_vaso.jpg')} alt="Vaso con una tapa Combata lima y pajita" width="756" height="1128" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="benefits" aria-label="Beneficios">
    <div class="container">
      <ul role="list" class="benefits__list">
        <li>
          <Icon name="shield" class="benefits__icon" />
          <h2>Una barrera<br />adicional</h2>
          <p>Añade una capa extra<br />de protección a tu bebida.</p>
        </li>
        <li>
          <Icon name="drop" class="benefits__icon" />
          <h2>Menos<br />derrames</h2>
          <p>Disfruta sin preocuparte<br />por salpicaduras.</p>
        </li>
        <li>
          <Icon name="refresh" class="benefits__icon" />
          <h2>Reutilizable<br />y duradero</h2>
          <p>Úsalo, lávalo<br />y llévalo contigo.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- DESCUBRE -->
  <section class="discover" aria-labelledby="discover-title">
    <div class="container discover__grid">
      <div class="discover__media">
        <img src={url('/img/tapas_apiladas.jpg')} alt="Tres tapas Combata apiladas en lima, rosa y lavanda" width="900" height="666" loading="lazy" />
      </div>
      <div class="discover__copy">
        <h2 id="discover-title" class="sec-title">Descubre<br />Combata</h2>
        <p class="sec-text">Elige tu color, combina<br />y llévate tu pack favorito.</p>
        <a class="btn btn-primary" href={url('/comprar')}>Ver productos <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- CUSTOM -->
  <section class="custom-band on-dark" aria-labelledby="custom-title">
    <svg class="custom-band__wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 90 V52 C 240 4, 420 0, 640 30 C 900 66, 1150 70, 1440 10 V90 Z" fill="currentColor" />
    </svg>
    <div class="container custom-band__grid">
      <div class="custom-band__copy">
        <h2 id="custom-title" class="sec-title">Combata Custom</h2>
        <p class="sec-text">Personalízalo para tu evento,<br />marca o celebración.</p>
        <a class="btn btn-ghost" href={url('/custom#presupuesto')}>Solicitar presupuesto <Icon name="arrow" /></a>
      </div>
      <div class="custom-band__media">
        <img src={url('/img/custom_vaso.jpg')} alt="Vaso con tapa Combata lavanda personalizada con el texto «Tu logo»" width="684" height="498" loading="lazy" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { background: var(--hero-grad); color: var(--color-cream); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 2rem; min-height: min(78vh, 720px); }
  .hero__copy { display: grid; gap: 1.75rem; justify-items: start; padding-block: clamp(3rem, 7vw, 6rem); }
  .hero__title { font-size: clamp(3.25rem, 1.8rem + 5.6vw, 6.5rem); line-height: .98; letter-spacing: -.04em; color: #fff; }
  .u { position: relative; display: inline-block; isolation: isolate; white-space: nowrap; }
  .hero__text { font-size: var(--step-1); line-height: 1.5; max-width: 30ch; color: rgba(255, 255, 255, .92); margin-top: .75rem; }
  .hero__media { align-self: end; justify-self: end; height: 100%; display: flex; align-items: flex-end; }
  .hero__media img {
    width: auto; max-height: min(78vh, 720px); object-fit: contain;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 18%, #000 88%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 14%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0, #000 18%, #000 88%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 14%);
    mask-composite: intersect;
  }

  /* BENEFICIOS */
  .benefits { background: var(--color-cream); padding-block: clamp(2.5rem, 5vw, 3.75rem); border-bottom: 1px solid var(--color-line); }
  .benefits__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
  .benefits__list li { display: grid; justify-items: center; gap: .6rem; }
  .benefits__list :global(.benefits__icon) { width: 44px; height: 44px; stroke-width: 1.6; margin-bottom: .4rem; }
  .benefits__list h2 { font-size: var(--step-1); line-height: 1.15; letter-spacing: -.02em; }
  .benefits__list p { font-size: var(--step--1); line-height: 1.45; }

  /* DESCUBRE */
  .discover { background: #F5EDEA; overflow: hidden; }
  .discover__grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(1.5rem, 4vw, 4rem); padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .discover__media img { width: 100%; -webkit-mask-image: radial-gradient(75% 75% at 50% 50%, #000 70%, transparent 100%); mask-image: radial-gradient(75% 75% at 50% 50%, #000 70%, transparent 100%); }
  .discover__copy { display: grid; gap: 1.5rem; justify-items: start; }
  .sec-title { font-size: clamp(2.5rem, 1.6rem + 3.2vw, 4.25rem); line-height: 1; letter-spacing: -.035em; }
  .sec-text { font-size: var(--step-2); line-height: 1.3; font-weight: 500; letter-spacing: -.015em; }

  /* CUSTOM */
  .custom-band { position: relative; background: #250833; color: var(--color-cream); margin-top: -1px; }
  .custom-band__wave { position: absolute; left: 0; right: 0; top: -60px; width: 100%; height: 61px; color: #250833; display: block; }
  .discover { padding-bottom: 60px; }
  .custom-band__grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: end; gap: 2rem; }
  .custom-band__copy { display: grid; gap: 1.25rem; justify-items: start; padding-block: clamp(2.5rem, 5vw, 4rem); align-self: center; }
  .custom-band .sec-title { color: #fff; }
  .custom-band .sec-text { color: rgba(255, 255, 255, .9); font-size: var(--step-1); }
  .custom-band__media { justify-self: end; }
  .custom-band__media img {
    width: min(100%, 560px);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 22%, #000 85%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 18%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0, #000 22%, #000 85%, transparent 100%), linear-gradient(to bottom, transparent 0, #000 18%);
    mask-composite: intersect;
  }

  @media (max-width: 820px) {
    .hero__grid { grid-template-columns: 1fr; min-height: 0; gap: 0; }
    .hero__copy { padding-block: 2.5rem 1rem; }
    .hero .btn-row { flex-direction: column; align-items: flex-start; }
    .hero__media { justify-self: end; margin-right: calc(var(--gutter) * -1); }
    .hero__media img { max-height: 420px; }
    .benefits__list { grid-template-columns: 1fr; gap: 2.25rem; }
    .discover__grid, .custom-band__grid { grid-template-columns: 1fr; }
    .discover__copy { order: -1; padding-top: 2rem; }
    .custom-band__media { margin-right: calc(var(--gutter) * -1); }
  }
</style>
